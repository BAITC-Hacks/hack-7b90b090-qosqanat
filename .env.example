OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_FALLBACK_MODEL=gpt-realtime
TEXT_MODEL=gpt-4.1-mini
TRANSCRIPTION_MODEL=gpt-live-transcribe
# Required for Docker. Local pnpm dev generates these in ignored var/local-config.json.
INTERNAL_SECRET=
STAFF_PASSWORD=
PUBLIC_ORIGIN=http://localhost:3000
SCENARIO_PORT=3002
GATEWAY_PORT=3001
SCENARIO_URL=http://127.0.0.1:3002
DATABASE_PATH=var/voice-router.sqlite
MAX_ACTIVE_MODELS=8
